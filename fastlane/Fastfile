default_platform(:ios)

platform :ios do
  desc "Z Bark uses the local signed archive workflow"
  lane :beta do
    UI.user_error!("Run python3 scripts/zbark.py archive --build-number NUMBER. Z Bark must not access upstream Match/App Store assets.")
  end

  desc "Run workspace regression tests"
  lane :tests do
    run_tests(workspace: "Bark.xcworkspace", scheme: "Bark")
  end
end
